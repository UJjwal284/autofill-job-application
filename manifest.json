{
  "manifest_version": 3,
  "name": "Resume Autofill for Job Applications",
  "version": "1.0.0",
  "description": "Save your resume once. Job application forms fill themselves. Fully local, no account, no tracking.",
  "permissions": ["storage"],
  "background": {
    "scripts": ["src/background/background.js"]
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Resume Autofill",
    "default_icon": {
      "48": "src/icons/icon-48.png",
      "96": "src/icons/icon-96.png"
    }
  },
  "icons": {
    "48": "src/icons/icon-48.png",
    "96": "src/icons/icon-96.png",
    "128": "src/icons/icon-128.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/lib/profile.js", "src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "resume-autofill@example.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
